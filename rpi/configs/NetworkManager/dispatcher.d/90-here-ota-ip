#!/bin/sh
# Keep a stable OTA service address on wlan0.
#
# The ESP fleet (legs + receiver) downloads firmware from a HARDCODED
# 192.168.1.110 (OTA_HOST in the firmware). The Pi's wlan0 is on DHCP, so
# after a reboot or lease change it can come up on a different address
# (we saw it drift to .116) — and then every device joins WiFi fine but
# can't reach the Pi to download, so OTA silently fails fleet-wide.
#
# This NetworkManager dispatcher runs on every wlan0 bring-up / address
# change and ensures 192.168.1.110/24 is always present as a secondary
# address, without disturbing the DHCP-assigned primary (so normal
# connectivity and here.local keep working either way).
#
# Idempotent. Installed by rpi/scripts/install.sh.
IFACE="$1"
ACTION="$2"

[ "$IFACE" = "wlan0" ] || exit 0

case "$ACTION" in
  up|dhcp4-change|connectivity-change)
    if ! ip -4 addr show dev wlan0 | grep -q "192.168.1.110/24"; then
      ip addr add 192.168.1.110/24 dev wlan0
      logger -t here-ota-ip "added OTA alias 192.168.1.110/24 to wlan0"
    fi
    ;;
esac
exit 0
